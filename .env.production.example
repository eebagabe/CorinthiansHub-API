# Copie para .env.production na VPS (chmod 600). Nunca vai para o git.
DB_USER=corinthians
DB_PASSWORD=troque-esta-senha
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
JWT_SECRET=gere-com-openssl-rand-base64-48
CORS_ORIGENS=https://seu-site.vercel.app
# Cloudflare R2 (fotos)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=corinthianshub-fotos
R2_URL_PUBLICA=https://fotos.seudominio.com
# Cloudflare Tunnel proprio (Zero Trust > Networks > Tunnels); hostname publico -> http://api:8081
TUNNEL_TOKEN=
